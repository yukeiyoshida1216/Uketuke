# このファイルを .env にコピーして値を入れる。 .env は Git に含めない。
# DRY_RUN=true のあいだは Slack へ投稿しない。本番運用だけ false にする。
DRY_RUN=true

# Slack App の Bot Token（chat:write）と通知先チャンネル ID。
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# 訪問先 ID → Slack User ID。受付画面の API には返さない。
# 担当者を足すときは config/destinations.json とこの対応を両方更新する。アプリの改修は不要。
SLACK_USER_IDS={"nosaka":"","yanase":"","ito":""}

# 面接・会社説明のメンション。 nosaka=野坂 星司 / yanase=梁瀬 聖太 / ito=伊藤 功 の三択。カンマ区切り。
INTERVIEW_MENTION_IDS=nosaka,yanase,ito

# 配達（受付メニューの「その他」）のメンション。同じ三択。
DELIVERY_MENTION_IDS=nosaka,yanase,ito

DESTINATIONS_FILE=./config/destinations.json
PORT=8787
